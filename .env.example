# Public settings only; never put credentials or service keys in VITE_* values.
# Copy to .env.local and restart Vite after changing settings.
# /products is appended to the API path, with or without a final slash.
VITE_API_BASE_URL=https://YOUR_ACTUAL_FUNCTION_HOSTNAME/api
# Use the separate frontend Application Insights resource's connection string.
# This is public ingestion configuration, not a secret. Leave blank to disable.
VITE_APPINSIGHTS_CONNECTION_STRING=
